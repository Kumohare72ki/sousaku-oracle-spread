            "愚者", "魔術師", "女教皇", "女帝", "皇帝", "教皇", "恋人", "戦車", "正義", "隠者", "運命の輪",
            "力", "吊るされた男", "死神", "節制", "悪魔", "塔", "星", "月", "太陽", "審判", "世界",
            "ワンドのA", "ワンドの2", "ワンドの3", "ワンドの4", "ワンドの5", "ワンドの6", "ワンドの7", "ワンドの8", "ワンドの9", "ワンドの10", "ワンドのペイジ", "ワンドのナイト", "ワンドのクイーン", "ワンドのキング",
            "カップのA", "カップの2", "カップの3", "カップの4", "カップの5", "カップの6", "カップの7", "カップの8", "カップの9", "カップの10", "カップのペイジ", "カップのナイト", "カップのクイーン", "カップのキング",
            "ソードのA", "ソードの2", "ソードの3", "ソードの4", "ソードの5", "ソードの6", "ソードの7", "ソードの8", "ソードの9", "ソードの10", "ソードのペイジ", "ソードのナイト", "ソードのクイーン", "ソードのキング",
            "ペンタクルのA", "ペンタクルの2", "ペンタクルの3", "ペンタクルの4", "ペンタクルの5", "ペンタクルの6", "ペンタクルの7", "ペンタクルの8", "ペンタクルの9", "ペンタクルの10", "ペンタクルのペイジ", "ペンタクルのナイト", "ペンタクルのクイーン", "ペンタクルのキング"
        ];

        const spreads = {
            one: {
                name: "ワンオラクル",
                positions: ["結果"]
            },
            two: {
                name: "ツーオラクル",
                positions: ["一枚目", "二枚目"]
            },
            three: {
                name: "スリーカード",
                positions: ["一枚目", "二枚目", "三枚目"]
            },
            four: {
                name: "フォーカード",
                positions: ["一枚目", "二枚目", "三枚目", "四枚目"]
            },
            celticCross: {
                name: "ケルト十字",
                positions: ["現在の状況", "障害・援助", "顕在意識", "潜在意識", "過去", "近い未来", "本人の立場・心理", "環境", "期待・恐れ", "最終結果"]
            },
            hexagram: {
                name: "ヘキサグラム",
                positions: ["過去", "現在", "近未来", "鍵", "環境", "障害", "結果"]
            },
            greek: {
                name: "ギリシャ十字",
                positions: ["現状", "障害", "将来・傾向", "対策", "結果"]
            },
            choice: {
                name: "二者択一",
                positions: ["現状", "選択肢Aの近未来", "選択肢Bの近未来", "選択肢Aの遠い未来", "選択肢Bの遠い未来","神託"]
            }
        };

        function drawCards() {
            const spreadKey = document.getElementById('spread-select').value;
            const spread = spreads[spreadKey];
            const deck = [...cards];
            let resultText = `【${spread.name}】\n`;
//            resultText += `実施日時: ${new Date().toLocaleString()}\n`;
            resultText += `---\n`;

            // シャッフル
            for (let i = deck.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [deck[i], deck[j]] = [deck[j], deck[i]];
            }

            // カード展開
            for (let i = 0; i < spread.positions.length; i++) {
                const card = deck[i];
                const isUpright = Math.random() > 0.5;
                const orientation = isUpright ? "正" : "逆";
                const num = i + 1;
//                resultText += `${num}枚目：${card}・${orientation} … ${spread.positions[i]}\n`;
                  resultText += `${spread.positions[i]}は${card}・${orientation}です。\n`;
            }

//            resultText += `---\n【リーディングメモ】\n`;

            document.getElementById('result-area').value = resultText;
        }
    </script>
</body>
</html>
